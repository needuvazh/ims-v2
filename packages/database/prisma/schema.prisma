model Refund {
  id                 String       @id @default(uuid()) @db.Uuid
  refundNumber       String       @db.VarChar(50)
  paymentId          String       @db.Uuid
  invoiceId          String       @db.Uuid
  branchId           String       @db.Uuid
  refundType         RefundType
  amount             Decimal      @db.Decimal(18, 3)
  currency           String       @default("OMR") @db.VarChar(3)
  reasonCode         String       @db.VarChar(50)
  reasonNarrative    String       @db.VarChar(1000)
  status             RefundStatus @default(Requested)
  requestedBy        String       @db.Uuid
  requestedAt        DateTime     @db.Timestamptz(6)
  decidedBy          String?      @db.Uuid
  decidedAt          DateTime?    @db.Timestamptz(6)
  decisionReason     String?      @db.VarChar(500)
  executedAt         DateTime?    @db.Timestamptz(6)
  executionReference String?      @db.VarChar(100)
  version            Int          @default(1)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy String?   @db.Uuid
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  updatedBy String?   @db.Uuid
  deletedAt DateTime? @db.Timestamptz(6)
  isDeleted Boolean   @default(false)

  // Relations
  payment   Payment @relation(fields: [paymentId], references: [id])
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  branch    Branch  @relation(fields: [branchId], references: [id])
  requester User    @relation("RefundRequester", fields: [requestedBy], references: [id])
  decider   User?   @relation("RefundDecider", fields: [decidedBy], references: [id])

  @@unique([branchId, refundNumber])
  @@index([paymentId])
  @@index([invoiceId])
  @@index([branchId])
  @@map("finance_refunds")
}

model Receivable {
  id                String           @id @default(uuid()) @db.Uuid
  invoiceId         String           @unique @db.Uuid
  branchId          String           @db.Uuid
  dueDate           DateTime         @db.Date
  outstandingAmount Decimal          @db.Decimal(18, 3)
  status            ReceivableStatus @default(Open)
  agingBucket       AgingBucket      @default(Current)
  lastCalculatedAt  DateTime         @db.Timestamptz(6)
  version           Int              @default(1)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy String?   @db.Uuid
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  updatedBy String?   @db.Uuid
  deletedAt DateTime? @db.Timestamptz(6)
  isDeleted Boolean   @default(false)

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@index([branchId, status, dueDate])
  @@map("finance_receivables")
}

model CorporateCreditRule {
  id                 String                    @id @default(uuid()) @db.Uuid
  corporateAccountId String                    @db.Uuid
  branchId           String                    @db.Uuid
  creditLimit        Decimal                   @db.Decimal(18, 3)
  currentOutstanding Decimal                   @default(0.000) @db.Decimal(18, 3)
  committedAmount    Decimal                   @default(0.000) @db.Decimal(18, 3)
  availableCredit    Decimal                   @db.Decimal(18, 3)
  blockOnCreditLimit Boolean                   @default(true)
  effectiveStartDate DateTime                  @db.Date
  effectiveEndDate   DateTime?                 @db.Date
  status             CorporateCreditRuleStatus @default(Draft)
  version            Int                       @default(1)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy String?   @db.Uuid
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  updatedBy String?   @db.Uuid
  deletedAt DateTime? @db.Timestamptz(6)
  isDeleted Boolean   @default(false)

  // Relations
  corporateAccount CorporateAccount @relation(fields: [corporateAccountId], references: [id])
  branch           Branch           @relation(fields: [branchId], references: [id])

  @@index([corporateAccountId, status])
  @@index([branchId])
  @@map("finance_corporate_credit_rules")
}
